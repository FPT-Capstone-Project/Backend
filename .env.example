NODE_ENV=development
PORT=3000

# Use DATABASE_URL or the individual DB_* values below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=capstone
DB_USER=postgres
DB_PASSWORD=your-postgres-password

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Gmail API OAuth2. The callback URL must match the one registered in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SePay dynamic VietQR payment
SEPAY_BANK_CODE=MB
SEPAY_ACCOUNT_NUMBER=your-bank-account-number
SEPAY_QR_TEMPLATE=compact
SEPAY_WEBHOOK_SECRET=replace-with-the-sepay-webhook-hmac-secret
SEPAY_WEBHOOK_MAX_AGE_SECONDS=300

# SmartMush EMQX Cloud. Empty host disables MQTT; REST reads remain available.
# Hostname only (no mqtts://). TLS certificate/hostname verification is required.
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
# A unique random suffix is appended per backend process.
MQTT_CLIENT_ID=smartmush-backend
# Automatic misting: real hardware is disabled by default. Keep .env private.
AUTO_MISTING_REAL_ENABLED=false
# Master identifier => verified local maximum-ON timeout (ms), e.g. {"master01":10000}
# Populate ONLY after firmware watchdog and emergency-stop verification.
AUTO_MISTING_VERIFIED_WATCHDOGS={}
