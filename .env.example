NODE_ENV=development
PORT=3000

# Use DATABASE_URL or the individual DB_* values below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=capstone
DB_USER=postgres
DB_PASSWORD=your-postgres-password

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SePay dynamic VietQR payment
SEPAY_BANK_CODE=MB
SEPAY_ACCOUNT_NUMBER=your-bank-account-number
SEPAY_QR_TEMPLATE=compact
SEPAY_WEBHOOK_SECRET=replace-with-the-sepay-webhook-hmac-secret
SEPAY_WEBHOOK_MAX_AGE_SECONDS=300
